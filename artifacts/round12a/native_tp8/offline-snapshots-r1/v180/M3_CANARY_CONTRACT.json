    {
      "id": "deterministic-short-generation",
      "prompt": "Transform the fixed lowercase sequence 'alpha beta gamma' to uppercase and join the words with vertical bars. Reply with only the transformed sequence.",
      "validator": {
        "kind": "exact_text",
        "expected": "ALPHA|BETA|GAMMA"
      }
    }
