        "expected": "391"
      }
    },
    {
      "id": "json",
      "prompt": "Return only a JSON object with keys name and count, values apple and 3. Do not use a Markdown code fence.",
      "validator": {
        "kind": "exact_json",
        "expected": {
          "name": "apple",
          "count": 3
        }
      }
    },
    {
      "id": "short-context-quote",
      "prompt": "Context: The brass key rests beneath the blue cup. Quote exactly the four words that state where the key rests. Reply with only those four words.",
      "validator": {
        "kind": "exact_text",
        "expected": "beneath the blue cup"
      }
